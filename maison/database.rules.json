{
  "rules": {
    // ══════════════════════════════════════════════════════════════════════
    // REGRAS DO BANCO — Maison Beauty
    //
    // Fica num projeto Firebase PRÓPRIO, separado do cartório.
    // Tudo é negado por padrão; só vale o que está listado aqui.
    //
    // Quem é quem mora em /acesso/{uid} = { nome, perfil, pro }, escrito à mão
    // no console (o painel nunca escreve ali — ninguém se libera sozinho):
    //   perfil "admin"       → Tháriga: as duas unidades e o dinheiro
    //   perfil "funcionaria" → Rafael, Laís, Mariana: só a Maison Beauty
    //   pro                  → rafael | lais | mariana | tha
    // ══════════════════════════════════════════════════════════════════════

    "acesso": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // ── Maison Beauty: Tháriga e as três funcionárias ──
    // Todas leem. Escrever, cada caminho tem a sua regra: a funcionária cria e
    // corrige clientes, agenda e anamnese, mas só a Tháriga apaga cliente,
    // anamnese, e corrige ou cancela atendimento já registrado.
    "maison": {
      ".read": "auth != null && root.child('acesso').child(auth.uid).exists()",
      "clientes": {
        "$id": { ".write": "auth != null && (root.child('acesso').child(auth.uid).child('perfil').val() === 'admin' || (root.child('acesso').child(auth.uid).exists() && newData.exists()))" }
      },
      "agenda": {
        // A Laís só atende às segundas. `ts` é a data à meia-noite UTC em milissegundos:
        // (dias desde 1970 + 4) % 7 dá o dia da semana (0 = domingo, 1 = segunda).
        // Agendamento antigo, de antes do `ts`, continua podendo ser atualizado.
        "$id": {
          ".write": "auth != null && (root.child('acesso').child(auth.uid).child('perfil').val() === 'admin' || (root.child('acesso').child(auth.uid).exists() && newData.exists()))",
          ".validate": "!newData.exists() || newData.child('pro').val() !== 'lais' || (data.exists() && !newData.child('ts').exists()) || (newData.child('ts').isNumber() && (newData.child('ts').val() / 86400000 + 4) % 7 === 1)"
        }
      },
      "atendimentos": {
        "$id": { ".write": "auth != null && (root.child('acesso').child(auth.uid).child('perfil').val() === 'admin' || (root.child('acesso').child(auth.uid).exists() && !data.exists()))" }
      },
      "anamneses": {
        "$id": { ".write": "auth != null && (root.child('acesso').child(auth.uid).child('perfil').val() === 'admin' || (root.child('acesso').child(auth.uid).exists() && newData.exists()))" }
      },
      // Registro do atendimento (página 2 da ficha): todas preenchem e corrigem, ninguém além da Tháriga apaga.
      "registros": {
        "$id": { ".write": "auth != null && (root.child('acesso').child(auth.uid).child('perfil').val() === 'admin' || (root.child('acesso').child(auth.uid).exists() && newData.exists()))" }
      },
      // Fotos: reduzidas no aparelho e guardadas aqui. Funcionária envia, só a Tháriga apaga.
      "fotos": {
        "$cid": {
          "$fid": {
            ".write": "auth != null && (root.child('acesso').child(auth.uid).child('perfil').val() === 'admin' || (root.child('acesso').child(auth.uid).exists() && !data.exists()))",
            ".validate": "newData.hasChildren(['tipo','data','img']) && newData.child('img').isString() && newData.child('img').val().length < 700000"
          }
        }
      },
      // Preços e serviços: todas leem (precisam do valor para concluir), só a Tháriga muda.
      "servicos": {
        ".write": "auth != null && root.child('acesso').child(auth.uid).child('perfil').val() === 'admin'"
      },
      // Anamnese por link. A cliente entra sem conta (login anônimo): lê só o convite dela
      // e grava UMA vez em /pendentes, enquanto o convite estiver aberto e dentro da validade.
      "convites": {
        ".read": "auth != null && root.child('acesso').child(auth.uid).exists()",
        "$t": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('acesso').child(auth.uid).exists()"
        }
      },
      "pendentes": {
        ".read": "auth != null && root.child('acesso').child(auth.uid).exists()",
        "$t": {
          ".write": "auth != null && (root.child('acesso').child(auth.uid).exists() || (!data.exists() && root.child('maison').child('convites').child($t).child('usado').val() === false && root.child('maison').child('convites').child($t).child('exp').val() > now))",
          ".validate": "newData.hasChildren(['nome','respostas','assinatura']) && newData.child('assinatura').isString() && newData.child('assinatura').val().length < 300000 && ((newData.child('fotoOk').val() === true && newData.child('fotos').hasChild('f0')) || (newData.child('fotoOk').val() !== true && !newData.child('fotos').exists()))",
          "fotos": {
            "f0": { ".validate": "newData.isString() && newData.val().length < 700000" },
            "f1": { ".validate": "newData.isString() && newData.val().length < 700000" },
            "f2": { ".validate": "newData.isString() && newData.val().length < 700000" },
            "$outra": { ".validate": false }
          }
        }
      },
      // Pedidos de ajuda: todas enviam, só a administradora lê (o suporte também recebe por e-mail).
      "suporte": {
        ".read": "auth != null && root.child('acesso').child(auth.uid).child('perfil').val() === 'admin'",
        "$id": { ".write": "auth != null && root.child('acesso').child(auth.uid).exists() && !data.exists()" }
      }
    },

    // ── Estúdio Florença: só a Tháriga ──
    "florenca": {
      ".read":  "auth != null && root.child('acesso').child(auth.uid).child('perfil').val() === 'admin'",
      ".write": "auth != null && root.child('acesso').child(auth.uid).child('perfil').val() === 'admin'"
    },

    // ── Dinheiro cobrado em cada atendimento ──
    // A funcionária registra o valor ao concluir (só cria, nunca lê nem corrige);
    // quem lê e corrige é a Tháriga. É o que mantém comissão e faturamento
    // fora da vista delas de verdade, e não só escondidos na tela.
    "financeiro": {
      "valores": {
        ".read": "auth != null && root.child('acesso').child(auth.uid).child('perfil').val() === 'admin'",
        "$id": {
          ".write": "auth != null && (root.child('acesso').child(auth.uid).child('perfil').val() === 'admin' || (!data.exists() && root.child('acesso').child(auth.uid).exists()))"
        }
      }
    },

    // ── Fornecedores, contas, cursos, aulas e configurações: só a Tháriga ──
    "admin": {
      ".read":  "auth != null && root.child('acesso').child(auth.uid).child('perfil').val() === 'admin'",
      ".write": "auth != null && root.child('acesso').child(auth.uid).child('perfil').val() === 'admin'"
    }
  }
}

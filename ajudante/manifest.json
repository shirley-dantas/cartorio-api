{
  "manifest_version": 3,
  "name": "Ajudante do painel — 20º Tabelião",
  "version": "0.1.8",
  "description": "Busca documentos nos sites que você já usa (JUCESP) e guarda no card do painel. Nada é pago sem o seu clique.",
  "permissions": ["storage", "tabs", "contentSettings", "declarativeNetRequest", "webNavigation", "scripting"],
  "host_permissions": [
    "https://www.jucesponline.sp.gov.br/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://cartorio-api.vercel.app/*"], "js": ["painel.js"], "run_at": "document_idle" },
    { "matches": ["https://www.jucesponline.sp.gov.br/*"], "js": ["jucesp.js"], "run_at": "document_idle" }
  ]
}

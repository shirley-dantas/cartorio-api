{
  "rules": {
    // ══════════════════════════════════════════════════════════════════════
    // REGRAS DO BANCO — 20º Tabelião
    //
    // Antes: o banco inteiro respondia a quem soubesse o endereço. Agora só
    // responde nos caminhos listados aqui — o que não está nesta lista é
    // negado por padrão, inclusive caminho novo criado por engano.
    //
    // O painel operacional continua sem login de propósito: o bot do
    // WhatsApp (api/salvar-caso.js) e o Apps Script das minutas escrevem
    // por REST, sem conta nenhuma. Fechar /casos hoje derrubaria os dois.
    // Para fechar também esses caminhos é preciso dar uma conta de serviço
    // aos dois — está anotado no FIREBASE.md.
    //
    // O /financeiro é outra história: só o painel escreve nele, então ele
    // exige conta e senha, e só de quem estiver em /acesso.
    // ══════════════════════════════════════════════════════════════════════

    // ── Quem tem acesso ao financeiro ──
    // Escrito à mão no console do Firebase (o painel nunca escreve aqui).
    //   /acesso/{uid} = { "nome": "Shirley", "dono": true }
    //   /acesso/{uid} = { "nome": "Grazi" }
    // "dono" marca quem pode abrir o cofre pessoal.
    "acesso": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // ── O dinheiro ──
    "financeiro": {
      "lancamentos": {
        ".read":  "auth != null && root.child('acesso').child(auth.uid).exists()",
        ".write": "auth != null && root.child('acesso').child(auth.uid).exists()"
      },
      "config": {
        ".read":  "auth != null && root.child('acesso').child(auth.uid).exists()",
        ".write": "auth != null && root.child('acesso').child(auth.uid).exists()"
      },
      // O cofre pessoal já vai cifrado, mas nem o embrulho precisa circular:
      // só a conta marcada como dona chega até ele.
      "pessoal": {
        ".read":  "auth != null && root.child('acesso').child(auth.uid).child('dono').val() === true",
        ".write": "auth != null && root.child('acesso').child(auth.uid).child('dono').val() === true"
      }
    },

    // ── Os orçamentos ──
    // Mesma tranca do /financeiro, e pela mesma razão: aqui moram nome de
    // cliente, valor de negócio e valor venal. A Grazi entra junto — é ela
    // que atende no balcão e dá o valor à cliente —, mas quem não tem conta
    // não vê número nenhum.
    //
    // A base de conhecimento vai no mesmo cadeado: ela guarda as regras de
    // cobrança do cartório, com os exemplos reais que as sustentam.
    "orcamentos": {
      ".read":  "auth != null && root.child('acesso').child(auth.uid).exists()",
      ".write": "auth != null && root.child('acesso').child(auth.uid).exists()"
    },
    "orcamento-conhecimento": {
      ".read":  "auth != null && root.child('acesso').child(auth.uid).exists()",
      ".write": "auth != null && root.child('acesso').child(auth.uid).exists()"
    },
    "orcamento-config": {
      ".read":  "auth != null && root.child('acesso').child(auth.uid).exists()",
      ".write": "auth != null && root.child('acesso').child(auth.uid).exists()"
    },

    // ── A Rede (prospecção) ──
    // Mesma tranca do cofre pessoal, e pelo mesmo motivo: aqui moram nomes,
    // profissões e endereços de clientes, lidos das minutas. Só a conta dona
    // lê e escreve — nem a Grazi, que abre o Financeiro, chega neste caminho.
    //
    // Quem varre as minutas (apps-script/cartorio-drive-api.js) NÃO passa por
    // estas regras: ele escreve com a chave da conta de serviço, que age como
    // administrador. Ver FIREBASE.md.
    "rede": {
      ".read":  "auth != null && root.child('acesso').child(auth.uid).child('dono').val() === true",
      ".write": "auth != null && root.child('acesso').child(auth.uid).child('dono').val() === true"
    },

    // ── Painel operacional (segue aberto — ver o aviso lá em cima) ──
    "casos":                 { ".read": true, ".write": true },
    "focos":                 { ".read": true, ".write": true },
    "resolucoesCentral":     { ".read": true, ".write": true },
    "lembretes":             { ".read": true, ".write": true },
    "meta":                  { ".read": true, ".write": true },
    "joaninha_perguntas":    { ".read": true, ".write": true },

    // ── O Radar Jurídico e a Base de Regras ──
    // Norma publicada é informação pública: aqui não mora nome, CPF nem valor
    // de cliente. Por isso o painel operacional — que não tem login — lê os
    // dois sem pedir conta, do mesmo jeito que lê os casos.
    //
    // A escrita segue aberta pela mesma razão de /casos: quem grava é a
    // função da Vercel (api/radar-juridico.js), por REST e sem conta nenhuma.
    // Fechar isto hoje mataria a varredura das seis da manhã. Está na mesma
    // lista de pendências do FIREBASE.md, e some junto com ela no dia em que
    // a conta de serviço existir.
    "radar-juridico":        { ".read": true, ".write": true },
    "radar-juridico-meta":   { ".read": true, ".write": true },
    "base-regras":           { ".read": true, ".write": true },

    // ── Regras de elaboração de minuta ──
    // Mesma razão do /base-regras: norma pública, sem nome nem CPF de
    // cliente, gravada por api/pesquisar-regras-minuta.js (Vercel, por REST,
    // sem conta). Some junto com a mesma pendência do FIREBASE.md.
    "regras-minuta":         { ".read": true, ".write": true },

    // ── As alíquotas de fora da Capital ──
    // Alíquota de imposto é informação pública, como norma publicada: aqui
    // não mora nome nem valor de cliente, só "o ITBI de Extrema-MG é tanto".
    // Por isso a leitura é aberta, como a do Radar.
    //
    // A escrita segue aberta pela mesma razão de /casos e /radar-juridico:
    // quem grava é a função da Vercel (api/aliquota-municipal.js), por REST e
    // sem conta. Está na mesma lista de pendências do FIREBASE.md, e some
    // junto com ela no dia em que a conta de serviço existir. Enquanto isso, o
    // que protege o orçamento não é a tranca: é a alíquota nascer 🔴 incerta e
    // o CHECK FINAL não fechar sem a confirmação dela.
    "orcamento-aliquotas":   { ".read": true, ".write": true },

    // ── Minutas (Apps Script) ──
    "jobs":                  { ".read": true, ".write": true },
    "modelos":               { ".read": true, ".write": true },

    // ── Bot do WhatsApp (api/salvar-caso.js) ──
    "sessao_ativa":          { ".read": true, ".write": true },
    "bot_ultimo_envio":      { ".read": true, ".write": true },
    "mensagens_processadas": { ".read": true, ".write": true },
    "log_webhook":           { ".read": true, ".write": true }
  }
}
